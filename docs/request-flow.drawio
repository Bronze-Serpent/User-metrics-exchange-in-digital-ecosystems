            <Array as="points">
              <mxPoint x="95" y="250" />
            </Array>
          </mxGeometry>
        </mxCell>
        <mxCell id="e5" edge="1" parent="1" source="browser" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0.858;exitY=1.01;exitDx=0;exitDy=0;entryX=0.848;entryY=0.038;entryDx=0;entryDy=0;strokeColor=#1f5582;strokeWidth=2;entryPerimeter=0;exitPerimeter=0;" target="backend" value="5) POST /user-exchange-metrics/users  (JSON-тело)&#xa;Content-Type: application/json&#xa;Origin: http://localhost:63342">
          <mxGeometry relative="1" x="0.4189" as="geometry">
