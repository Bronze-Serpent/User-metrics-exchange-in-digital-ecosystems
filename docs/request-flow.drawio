        <mxCell id="backend" parent="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=12;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;Spring Boot REST API&lt;/b&gt;&#xa;&#xa;http://localhost:8080&#xa;/user-exchange-metrics/...&#xa;Контроллеры → сервисы → JPA" vertex="1">
          <mxGeometry height="120" width="260" x="30" y="370" as="geometry" />
