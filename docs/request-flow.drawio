        <mxCell id="db" parent="1" style="shape=cylinder3;whiteSpace=wrap;html=1;boundedLbl=1;backgroundOutline=1;size=15;fillColor=#f8cecc;strokeColor=#b85450;fontSize=12;verticalAlign=top;spacingTop=10;" value="&lt;b&gt;PostgreSQL&lt;/b&gt;&#xa;&#xa;База данных" vertex="1">
          <mxGeometry height="120" width="180" x="860" y="370" as="geometry" />
        </mxCell>
        <mxCell id="e1" edge="1" parent="1" source="browser" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.25;entryDx=0;entryDy=0;strokeColor=#1f5582;strokeWidth=2;" target="idea" value="1) GET /User-metrics.../frontend/pages/user.html (и css/js)">
          <mxGeometry relative="1" x="-0.3333" y="40" as="geometry">
            <mxPoint as="offset" />
          </mxGeometry>
        </mxCell>
        <mxCell id="e2" edge="1" parent="1" source="idea" style="endArrow=classic;html=1;rounded=0;fontSize=11;dashed=1;exitX=0;exitY=0.75;exitDx=0;exitDy=0;entryX=1;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#d6b656;strokeWidth=2;" target="browser" value="2) 200 OK + содержимое файлов с диска">
          <mxGeometry relative="1" x="-0.0667" y="20" as="geometry">
