        <mxCell id="e3" edge="1" parent="1" source="browser" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#1f5582;strokeWidth=2;" target="backend" value="3) (для POST с JSON) CORS-preflight: OPTIONS&#xa;Origin: http://localhost:63342">
          <mxGeometry relative="1" as="geometry">
