        <mxCell id="title" parent="1" style="text;html=1;align=center;verticalAlign=middle;fontSize=16;fontStyle=1;fillColor=none;strokeColor=none;" value="Поток запросов: браузер ↔ IDEA web-server ↔ Spring Boot ↔ БД" vertex="1">
