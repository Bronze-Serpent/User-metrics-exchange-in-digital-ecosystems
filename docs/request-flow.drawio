        <mxCell id="e6" edge="1" parent="1" source="backend" style="endArrow=classic;html=1;rounded=0;fontSize=11;exitX=1;exitY=0.4;exitDx=0;exitDy=0;entryX=0;entryY=0.4;entryDx=0;entryDy=0;strokeColor=#82b366;strokeWidth=2;" target="db" value="6) SQL (через JPA/Hibernate)">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e7" edge="1" parent="1" source="db" style="endArrow=classic;html=1;rounded=0;fontSize=11;dashed=1;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.7;entryDx=0;entryDy=0;strokeColor=#b85450;strokeWidth=2;" target="backend" value="7) ResultSet → Entity">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e8" edge="1" parent="1" source="backend" style="endArrow=classic;html=1;rounded=0;fontSize=11;dashed=1;exitX=0;exitY=0.25;exitDx=0;exitDy=0;entryX=0;entryY=0.75;entryDx=0;entryDy=0;strokeColor=#82b366;strokeWidth=2;" target="browser" value="8) 200 OK + JSON-ответ (DTO, сериализованный Jackson)&#xa;Access-Control-Allow-Origin: http://localhost:63342">
          <mxGeometry relative="1" x="-0.1852" as="geometry">
