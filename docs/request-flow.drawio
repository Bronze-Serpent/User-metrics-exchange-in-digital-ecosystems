        <mxCell id="e4" edge="1" parent="1" source="backend" style="endArrow=classic;html=1;rounded=0;fontSize=11;dashed=1;exitX=0.25;exitY=0;exitDx=0;exitDy=0;entryX=0.165;entryY=1.031;entryDx=0;entryDy=0;strokeColor=#82b366;strokeWidth=2;entryPerimeter=0;" target="browser" value="4) 200 OK&#xa;Access-Control-Allow-Origin: http://localhost:63342&#xa;Access-Control-Allow-Methods: GET,POST,PUT,DELETE,OPTIONS&#xa;Access-Control-Allow-Headers: *">
          <mxGeometry relative="1" x="0.5036" y="-1" as="geometry">
